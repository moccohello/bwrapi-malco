<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Malco</RootNamespace>
    <AssemblyName>Malco</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SelfContained>false</SelfContained>
    <RuntimeFrameworkVersion>10.0.10</RuntimeFrameworkVersion>
    <RollForward>LatestPatch</RollForward>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreSources>$(LocalAppData)\BWRAPI\packages;https://api.nuget.org/v3/index.json</RestoreSources>
    <!-- English uses the invariant resources; only Korean needs satellite assemblies. -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <ApplicationIcon>assets\overlay-mutalisk.ico</ApplicationIcon>
    <!-- The embedded SDK package comes from the local BWRAPI package feed and
         stages its exact product-local runtime. -->
    <BwrApiClientVersion>4.0.0-embedded-preview.81</BwrApiClientVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Malco.Telemetry\telemetry-policy.json" Link="telemetry-policy.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="BwrApi.Client" Version="$(BwrApiClientVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Malco.Telemetry\Malco.Telemetry.csproj" />
  </ItemGroup>

</Project>
